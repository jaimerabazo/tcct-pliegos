# Plantilla de variables de entorno — copiar a .env.local y rellenar con los valores
# del entorno DEV (los de staging/prod viven en Vercel y GitHub, NUNCA en local).
# Mapa completo por entorno: docs/BLOQUE-2-ENTORNOS.md §4.

# ── Base de datos (Supabase Postgres) ────────────────────────────────────────
# ⚠️ Usar el connection string del "Session pooler" (host *.pooler.supabase.com),
# NO la conexión "Direct" (es IPv6-only, inalcanzable desde Vercel y muchas redes).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Backend: verifica los JWT de sesión (Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=

# Frontend (prefijo VITE_ = se expone al navegador; el anon key es público por diseño)
VITE_SUPABASE_URL=https://ifbfvtkfewrdewvanmnf.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlmYmZ2dGtmZXdyZGV3dmFubW5mIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM1MDQzNTksImV4cCI6MjA5OTA4MDM1OX0.HYe-O-g_GDSmY4FxXmR7uJN6AGm9GSCERHSF2h87RHg

# ── Anthropic (extracción LLM + síntesis de presentaciones) ──────────────────
# Una key POR ENTORNO, con límite de gasto en dev/staging (Console → Spend limits).
ANTHROPIC_API_KEY=
# Opcional; por defecto la app usa claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
