// Prisma schema — plataforma de análisis de pliegos (pivot B2B SaaS, Bloque 3)
// Diseño de tenancy: docs/BLOQUE-1-DISENO-TENANCY.md §1. Esta es la migración EXPAND
// (docs/BLOQUE-2-ENTORNOS.md §3): todo lo nuevo es aditivo y las columnas de tenancy en
// Pliego son nullable para que el código actual siga funcionando durante la transición.
// La unicidad por org se adelanta para habilitar escrituras multi-tenant; el CONTRACT
// (organizationId NOT NULL y RLS) llega en la fase 5, cuando nada escriba sin org.

// Generador clásico (JS, no el nuevo "prisma-client" basado en TS) — el proyecto es
// JS puro (Vite + Vercel Functions sin build de TypeScript), así que evitamos depender
// de un loader de TS solo para el cliente de Prisma.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 ya no acepta `url` aquí: la URL de Migrate vive en prisma.config.ts, y el
// PrismaClient en tiempo de ejecución recibe la conexión vía un `adapter` explícito
// (@prisma/adapter-pg) en api/_lib/prisma.js y prisma/seed.js.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  name      String // razón social visible ("Acme Consulting SL")
  slug      String    @unique // identificador url-safe ("acme-consulting")
  plan      String    @default("trial") // trial|starter|pro — String, no enum: los planes
  //                                       cambiarán con el pricing; un enum de Postgres
  //                                       exigiría migración por cada cambio (Bloque 4 lo refina)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete con purga a 30 días (decisión D3, BLOQUE-1 §5); el
  //                     middleware rechaza toda request a una org desactivada (403)

  memberships Membership[]
  invitations Invitation[]
  pliegos     Pliego[]
  usageEvents UsageEvent[]
  auditLog    AuditEntry[]

  @@map("organizations")
}

enum Role {
  owner
  member
}

model Membership {
  userId         String // uuid de auth.users (Supabase Auth). SIN foreign key: auth.users
  //                       vive en el schema `auth` de Supabase y Prisma modela `public`;
  //                       un FK cross-schema ataría nuestro schema al interno de Supabase.
  //                       Integridad garantizada por el flujo de invitación (solo se crea
  //                       membership al aceptar una invitación).
  organizationId String
  role           Role     @default(member)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId]) // un usuario no puede estar dos veces en la misma org;
  //                                la unicidad la garantiza la BD, no el código
  @@index([organizationId]) // la query "miembros de esta org" (la PK ya cubre la inversa)
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(member)
  tokenHash      String    @unique // HASH (sha-256) del token, NUNCA el token en claro.
  //                                  Mismo principio que las contraseñas: si roban la BD,
  //                                  no pueden usar las invitaciones pendientes.
  expiresAt      DateTime // 7 días; una invitación eterna es una puerta eterna
  acceptedAt     DateTime? // null = pendiente. No se borra al aceptar: es historial
  createdBy      String // userId del que invitó (audit)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email]) // "¿tiene ya este email una invitación pendiente aquí?"
  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOMINIO (la tabla original, ahora scoped por organización)
// ─────────────────────────────────────────────────────────────────────────────

model Pliego {
  id             String    @id @default(cuid())
  organizationId String? // LA columna del tenancy. Nullable SOLO durante el expand; el
  //                        contract (fase 5) la hace NOT NULL cuando todo escriba scoped.
  expediente     String
  titulo         String
  organismo      String
  importe        Float?
  lotes          Int
  estado         String
  procedimiento  String
  ens            String
  fechaAnalisis  DateTime  @default(now())
  fechaLimite    DateTime?
  analysisData   Json?
  createdBy      String? // userId — quién lo subió (nullable durante el expand)
  updatedBy      String? // userId — última edición humana (audit ligero; el detalle
  //                        fino va en audit_log)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, expediente]) // el mismo expediente público puede existir en varios tenants
  @@index([organizationId, fechaAnalisis(sort: Desc)]) // la query del dashboard, tal cual
}

// ─────────────────────────────────────────────────────────────────────────────
// METERING Y AUDITORÍA (append-only: la app solo inserta; el RLS de la fase 5
// prohibirá UPDATE/DELETE — un registro de auditoría editable no es auditoría)
// ─────────────────────────────────────────────────────────────────────────────

model UsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String // 'analyze' | 'presentation' — String, no enum: añadir un tipo
  //                       de evento no debería requerir migración
  tokensIn       Int
  tokensOut      Int
  costEstimate   Decimal? @db.Decimal(10, 6) // € al precio de HOY, congelado. Los precios
  //                                            de Anthropic cambian; la contabilidad no se recalcula.
  pliegoId       String? // SIN FK a propósito: la contabilidad sobrevive al borrado del
  //                        pliego. Un evento es un hecho histórico, no una relación viva.
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt]) // LA query de metering: "eventos de esta org este
  //                                      mes". El índice se diseña desde la query, no al revés.
  @@map("usage_events")
}

model AuditEntry {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String // convención 'entidad.verbo': 'pliego.create', 'pliego.update',
  //                       'member.invite', 'member.remove', 'org.plan_change'...
  entityType     String
  entityId       String
  detail         Json? // el diff o contexto ({ seccion: 'lotes', antes: X, despues: Y })
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}
